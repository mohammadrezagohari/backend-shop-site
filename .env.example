APP_NAME="Golden AID API"
APP_ENV=develop
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SITE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# APP_ENV=production enables live Zarinpal and Kavenegar; use HTTPS URLs and APP_DEBUG=false.
# Storefront amounts are toman and are converted to rial on the server.
ZARINPAL_MERCHANT_ID=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Marketplace accounts are not configured yet. All outbound publication is disabled.
MARKETPLACE_AUTO_SYNC=false
TOROB_ENABLED=false
TOROB_FEE_MODEL=cpc
TOROB_COMMISSION_PERCENT=
# Optional base64 raw Ed25519 public key override; official key is the default.
# TOROB_PUBLIC_KEY=
BASALAM_ENABLED=false
BASALAM_ACCESS_TOKEN=
BASALAM_VENDOR_ID=
BASALAM_AMOUNT_MULTIPLIER=10
BASALAM_FEE_MODEL=commission
BASALAM_COMMISSION_PERCENT=
DIGIKALA_ENABLED=false
DIGIKALA_ACCESS_TOKEN=
DIGIKALA_SELLER_ID=
DIGIKALA_FEE_MODEL=commission
DIGIKALA_COMMISSION_PERCENT=
MARKETPLACE_CUSTOM_ENABLED=false
MARKETPLACE_CUSTOM_NAME="پلتفرم دیگر"
MARKETPLACE_CUSTOM_URL=
MARKETPLACE_CUSTOM_TOKEN=
MARKETPLACE_CUSTOM_FEE_MODEL=unknown
MARKETPLACE_CUSTOM_COMMISSION_PERCENT=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=golden_aid
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeded local administrator (change these outside local development)
ADMIN_NAME="Golden AID Admin"
ADMIN_EMAIL=admin@goldenaid.test
ADMIN_PASSWORD=password
